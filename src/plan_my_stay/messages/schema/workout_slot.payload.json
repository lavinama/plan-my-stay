    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "start": {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "title": "Start",
      "type": "string"
    },
    "end": {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "title": "End",
      "type": "string"
    },
    "place": {
