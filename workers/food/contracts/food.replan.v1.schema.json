{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "food.replan.v1.schema.json",
  "title": "Food replan request",
  "type": "object",
  "required": ["type", "trip", "travelers", "meal_slots", "candidate_pool"],
  "properties": {
    "type": {"const": "food.replan.v1"},
    "trip": {
      "type": "object",
      "required": ["id", "revision", "city", "timezone"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 0},
        "city": {"type": "string"},
        "timezone": {"type": "string"},
        "selected_stay": {"type": ["object", "null"]},
        "freshness_policy": {"type": "object"}
      },
      "additionalProperties": true
    },
    "previous_trip_revision": {"type": ["integer", "null"], "minimum": 0},
    "changed_by": {"type": "string"},
    "change_event": {"type": "object"},
    "travelers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "hard_requirements": {"type": "array", "items": {"type": "string"}},
          "preferred_cuisines": {"type": "array", "items": {"type": "string"}},
          "disliked_cuisines": {"type": "array", "items": {"type": "string"}},
          "feedback_event_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "meal_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "start", "end"],
        "properties": {
          "id": {"type": "string"},
          "date": {"type": "string", "format": "date"},
          "start": {"type": "string"},
          "end": {"type": "string"},
          "anchor": {"type": ["object", "null"]},
          "max_distance_km": {"type": "number", "minimum": 0},
          "minimum_options": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "candidate_pool": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "address": {"type": "string"},
          "location": {"type": ["object", "null"]},
          "cuisines": {"type": "array", "items": {"type": "string"}},
          "verified_attributes": {"type": "object"},
          "travel_estimate": {"type": "object"},
          "evidence": {
            "type": "object",
            "required": ["source_urls"],
            "properties": {
              "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
              "menu": {"type": "object"},
              "hours": {"type": "object"},
              "price": {"type": "object"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
