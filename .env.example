# Copy to .env and fill in. .env is git-ignored: never commit it. Values are shared privately.
# Which seat needs what is in README.md ("Secrets and who holds them").

# Routing seat only (Mario). Enable billing, Geocoding and the Routes API; restrict the key and cap its quota.
GOOGLE_MAPS_API_KEY=

# Every teammate: Keenable's keyless limit is per IP and the venue WiFi shares one, so each person needs a key (keen_...).
KEENABLE_API_KEY=

# Superlinked SIE (small models + reranker). Mario holds the key.
SUPERLINKED_API_KEY=
SUPERLINKED_BASE_URL=https://api.superlinked.com

# Cognee Cloud: one shared account and key for the whole team.
COGNEE_API_KEY=
COGNEE_TENANT_ID=
COGNEE_BASE_URL=
# The shared dataset's UUID, never its name: a name creates your own, unshared dataset.
COGNEE_DATASET_ID=

# Concierge only: the frontier model that arbitrates and writes the itinerary.
ANTHROPIC_API_KEY=

# Where `agent_config.yaml` lives (BAND agent ids and API keys, one entry per seat; git-ignored).
BAND_CONFIG_PATH=agent_config.yaml

# Percentage added to a stay total whose fee basis is unknown (0.15 = 15%). Placeholder: the team picks it.
FEE_RESERVE_PCT=0.15
